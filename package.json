{
  "name": "newsletter",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "description": "Nyhedsbrevsgenerator til faglig klub — paste meeting notes, get a laid-out A4 newsletter. Runs entirely in the browser.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "bun run build:assets && astro build",
    "build:assets": "bun run scripts/build-logo-png.ts && bun run scripts/build-pdf-fonts.ts",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && bun run check:native",
    "test": "bun test",
    "test:e2e": "playwright test",
    "smoke": "bun run scripts/smoke.ts",
    "format": "biome check --write .",
    "check:bundle": "bun run build:assets && astro build && bun run scripts/check-bundle.ts",
    "check:native": "bunx --bun svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@libpdf/core": "0.5.2",
    "@nanostores/persistent": "1.3.5",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@unocss/astro": "66.11.0",
    "astro": "7.3.8",
    "docx": "9.10.0",
    "idb-keyval": "6.3.0",
    "nanostores": "1.5.5",
    "pagedjs": "0.4.3",
    "svelte": "5.57.2",
    "unocss": "66.11.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.6.3",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/source-serif-4": "5.3.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.3",
    "axe-core": "4.14.0",
    "jszip": "3.10.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "wawoff2": "2.0.1",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
